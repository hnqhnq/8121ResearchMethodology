% ---- amsthm
\newtheoremstyle{MyDefinition}% name of the style to be used
  {\topsep}% measure of space to leave above the theorem. E.g.: 3pt
  {\topsep}% measure of space to leave below the theorem. E.g.: 3pt
  {}% name of font to use in the body of the theorem
  {}% measure of space to indent
  {\bfseries}% name of head font
  {}% punctuation between head and body
  {0.5em plus 0.75em}% space after theorem head; " " = normal interword space
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}% Manually specify head

\theoremstyle{MyDefinition}
\newtheorem{Theorem}{Theorem}
\newtheorem{Lemma}{Lemma}
\newtheorem{Definition}{Definition}
\newtheorem{Example}{Example}
\newtheorem{Exception}{Exceptional case}
\newtheorem{Corollary}{Corollary}

\def\Definitionautorefname{Definition}
\def\Theoremautorefname{Theorem}
\def\Corollaryautorefname{Corollary}
\def\Lemmaautorefname{Lemma}

\newcommand{\thsep}[1][1.5em]{\hspace{0pt plus #1}}

% ---- algorithm2e
\ifAlgoIIe
\RestyleAlgo{ruled}
\SetAlgoLined
\LinesNumbered
\newcommand{\myfuncsty}[1]{$\mathsf{#1}$}
\SetFuncSty{myfuncsty}
\SetKwFunction{KwFun}{function}
\SetKwProg{Fn}{function}{ begin}{end}
\SetKw{KwRaise}{raise}
\SetKwIF{IRaise}{IElseRaise}{IElseDo}{raise}{if}{else raise}{else do}{end raise}
\SetKwInput{KwEx}{Exception}
\fi

